<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.caspar.mapper.UserDormitoryMapper">

    <resultMap id="BaseResultMap" type="com.caspar.entity.UserDormitory">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="campus" property="campus"/>
        <result column="building" property="building"/>
        <result column="room" property="room"/>
        <result column="bed" property="bed"/>
        <result column="check_in_date" property="checkInDate"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM user_dormitory WHERE user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_dormitory (user_id, campus, building, room, bed, check_in_date, create_time)
        VALUES (#{userId}, #{campus}, #{building}, #{room}, #{bed}, #{checkInDate}, CURRENT_TIMESTAMP)
    </insert>

    <update id="update">
        UPDATE user_dormitory
        SET campus = #{campus},
            building = #{building},
            room = #{room},
            bed = #{bed},
            check_in_date = #{checkInDate},
            update_time = CURRENT_TIMESTAMP
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteByUserId">
        DELETE FROM user_dormitory WHERE user_id = #{userId}
    </delete>

    <update id="updateBuildingAndCampus">
        UPDATE user_dormitory
        SET building = #{newBuilding},
            campus = #{campus},
            update_time = CURRENT_TIMESTAMP
        WHERE building = #{oldBuilding}
    </update>

</mapper>
